# Local PostgreSQL and Docker Compose
POSTGRES_USER=ragxiv
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=ragxiv
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Used when running the Python API directly on the host. Compose builds its
# container-safe connection URL from the POSTGRES_* variables above.
DATABASE_URL=postgresql+psycopg://ragxiv:replace-with-a-strong-password@localhost:5432/ragxiv

# External services
OPENAI_API_KEY=replace-with-an-openai-api-key

# Runtime options
API_PORT=8001
LOG_LEVEL=INFO
SQL_ECHO=false
